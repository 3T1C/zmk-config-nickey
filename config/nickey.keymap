// mouse tuning

#define ZMK_POINTING_DEFAULT_MOVE_VAL 1200
#define ZMK_POINTING_DEFAULT_SCRL_VAL 600

#include <dt-bindings/zmk/input_transform.h>
#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <dt-bindings/zmk/mouse.h>
#include <behaviors/mouse_keys.dtsi>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

&mmv_input_listener { input-processors = <&zip_xy_scaler 2 1>; };

&msc_input_listener { input-processors = <&zip_scroll_scaler 2 1>; };

&mt {
    flavor = "balanced";
    quick-tap-ms = <0>;
};

&lt {
    quick-tap-ms = <300>;
    flavor = "balanced";
};

&mmv {
    time-to-max-speed-ms = <400>;
    acceleration-exponent = <1>;
    trigger-period-ms = <14>;
};

&msc {
    acceleration-exponent = <1>;
    time-to-max-speed-ms = <100>;
    delay-ms = <0>;
};

/ {
    combos {
        compatible = "zmk,combos";

        esc {
            bindings = <&kp ESCAPE>;
            key-positions = <0 1>;
            layers = <0 5>;
        };

        select_to_bol {
            bindings = <&kp LS(HOME)>;
            key-positions = <32 33>;
            layers = <0>;
        };

        select_to_eol {
            bindings = <&kp LS(END)>;
            key-positions = <34 35>;
            layers = <0>;
        };

        word_backward {
            bindings = <&kp LC(LEFT_ARROW)>;
            key-positions = <18 19>;
            layers = <0>;
        };

        word_forward {
            bindings = <&kp LC(RIGHT)>;
            key-positions = <20 21>;
            layers = <0>;
        };

        mousekey_3 {
            bindings = <&mkp MB3>;
            key-positions = <17 29>;
            layers = <2>;
        };

        esc-jk {
            bindings = <&kp ESCAPE>;
            key-positions = <19 20>;
            layers = <0>;
        };

        capword {
            bindings = <&caps_word>;
            key-positions = <24 37>;
            layers = <0>;
        };
    };

    macros {
        m0: m0 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp EQUAL &kp GT>;
            label = "M0";
        };

        m1: m1 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LCTRL &kp LSHFT>,
                <&macro_tap>,
                <&kp ESC>,
                <&macro_release>,
                <&kp LCTRL &kp LSHFT>;

            label = "M1";
        };

        m2: m2 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp RGUI &kp LCTRL>,
                <&macro_tap>,
                <&kp LEFT>,
                <&macro_release>,
                <&kp RGUI &kp LCTRL>;

            label = "M2";
        };

        m3: m3 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp RGUI &kp LCTRL>,
                <&macro_tap>,
                <&kp RIGHT>,
                <&macro_release>,
                <&kp RGUI &kp LCTRL>;

            label = "M3";
        };

        m4: m4 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp RGUI &kp LCTRL>,
                <&macro_tap>,
                <&kp D>,
                <&macro_release>,
                <&kp RGUI &kp LCTRL>;

            label = "M4";
        };

        m5: m5 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp RGUI &kp LCTRL>,
                <&macro_tap>,
                <&kp F4>,
                <&macro_release>,
                <&kp RGUI &kp LCTRL>;

            label = "M5";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        layer_0 {
            bindings = <
&kp TAB        &kp Q    &kp W  &kp E  &kp R  &kp T                                       &kp Y      &kp U  &kp I      &kp O    &kp P      &to 8
&kp BACKSPACE  &kp A    &kp S  &kp D  &kp F  &kp G                                       &kp H      &kp J  &kp K      &kp L    &kp SEMI   &kp ENTER
&sk LSHFT      &lt 4 Z  &kp X  &kp C  &kp V  &kp B      &kp LEFT_ALT      &kp RIGHT_WIN  &kp N      &kp M  &kp COMMA  &kp DOT  &kp RCTRL  &sk RIGHT_SHIFT
                                      &mo 1  &kp LCTRL  &kp LEFT_SHIFT    &kp LEFT_ALT   &kp SPACE  &mo 2
            >;
        };

        layer_1 {
            bindings = <
&kp ESCAPE      &kp GRAVE        &kp TILDE    &kp PLUS       &kp EQUAL     &sk LC(LEFT_SHIFT)                                  &sk LS(LEFT_ALT)   &kp LESS_THAN   &kp GREATER_THAN   &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp RIGHT_GUI
&trans          &kp EXCLAMATION  &kp AT_SIGN  &kp HASH       &kp DOLLAR    &kp LEFT_BRACKET                                    &kp RIGHT_BRACKET  &kp MINUS       &kp SQT            &kp LEFT_BRACE        &kp RIGHT_BRACE        &kp ENTER
&kp LEFT_SHIFT  &kp PERCENT      &kp CARET    &kp AMPERSAND  &kp ASTERISK  &kp QUESTION        &kp RCTRL        &kp RIGHT_WIN  &kp COLON          &kp UNDERSCORE  &kp DOUBLE_QUOTES  &kp PIPE              &kp SLASH              &kp BACKSLASH
                                                             &trans        &trans              &kp RIGHT_ALT    &kp RIGHT_ALT  &kp SPACE          &trans
            >;
        };

        layer_2 {
            bindings = <
&kp TAB    &kp NUMBER_1  &kp N2  &kp N3  &kp N1  &none                                  &msc SCRL_LEFT  &msc SCRL_DOWN  &msc SCRL_UP  &msc SCRL_RIGHT  &to 5          &m1
&trans     &kp N4        &kp N5  &kp N6  &kp N0  &mkp MB2                               &kp LEFT        &kp DOWN        &kp UP        &kp RIGHT        &kp RIGHT_GUI  &kp ENTER
&kp LSHFT  &kp N7        &kp N8  &kp N9  &kp M   &mkp MB1   &kp LCTRL        &kp RCTRL  &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_UP  &mmv MOVE_RIGHT  &kp LEFT_ALT   &mkp MB1
                                         &trans  &kp SPACE  &kp RIGHT_ALT    &trans     &trans          &trans
            >;
        };

        layer_3 {
            bindings = <
&trans     &kp F1  &kp F2  &kp F3  &kp F10  &kp PAGE_UP                           &kp PAGE_DOWN  &m2                     &m3                         &kp LS(DELETE)               &kp RGUI  &kp PRINTSCREEN
&trans     &kp F4  &kp F5  &kp F6  &kp F11  &kp HOME                              &kp LS(HOME)   &kp LALT                &kp RCTRL                   &kp RGUI                     &kp RALT  &kp ENTER
&kp LSHFT  &kp F7  &kp F8  &kp F9  &kp F12  &kp END      &m4              &m5     &kp LS(END)    &kp LG(LS(LEFT_ARROW))  &kp LC(LA(LG(LEFT_ARROW)))  &kp LA(LC(LG(RIGHT_ARROW)))  &kp DEL   &kp RSHFT
                                   &trans   &trans       &kp RIGHT_ALT    &trans  &trans         &trans
            >;
        };

        layer_4 {
            bindings = <
&bt BT_CLR      &bt BT_SEL 0  &bt BT_SEL 1   &kp C_VOL_DN  &kp C_VOLUME_UP  &kp C_BRIGHTNESS_DEC                            &kp C_BRIGHTNESS_INC  &kp N7     &kp N8  &kp N9  &kp ASTERISK  &kp BACKSPACE
&bt BT_CLR_ALL  &sk LGUI      &sk RIGHT_ALT  &sk RCTRL     &sk LEFT_SHIFT   &kp LEFT_WIN                                    &kp PLUS              &kp N4     &kp N5  &kp N6  &kp N0        &kp ENTER
&studio_unlock  &trans        &trans         &trans        &trans           &kp ASTERISK          &kp LEFT_SHIFT    &trans  &kp MINUS             &kp N1     &kp N2  &kp N3  &kp PERIOD    &kp COMMA
                                                           &kp LEFT_ALT     &kp LCTRL             &kp RIGHT_ALT     &trans  &kp SPACE             &kp SLASH
            >;
        };

        layer_5 {
            bindings = <
&kp TAB    &kp Q  &kp W  &kp E  &kp R      &kp T                       &kp Y   &kp U   &kp I      &kp O    &kp P      &to 0
&mo 7      &kp A  &kp S  &kp D  &kp F      &kp G                       &kp H   &kp J   &kp K      &kp L    &kp SEMI   &kp ENTER
&kp LSHFT  &kp Z  &kp X  &kp C  &kp V      &kp B  &kp LCTRL    &trans  &kp N   &kp M   &kp COMMA  &kp DOT  &kp SLASH  &kp END
                                &kp SPACE  &mo 6  &kp LALT     &trans  &trans  &trans
            >;
        };

        layer_6 {
            bindings = <
&kp RCTRL      &kp NUMBER_1  &kp N2  &kp N3  &kp N1     &trans                              &msc SCRL_LEFT  &msc SCRL_DOWN  &msc SCRL_UP  &msc SCRL_RIGHT  &trans         &none
&kp RIGHT_ALT  &kp N4        &kp N5  &kp N6  &kp N0     &kp J                               &kp LEFT        &kp DOWN        &kp UP        &kp RIGHT        &kp RIGHT_GUI  &kp ENTER
&kp LSHFT      &kp N7        &kp N8  &kp N9  &kp M      &kp F1  &kp LCTRL        &kp RCTRL  &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_UP  &mmv MOVE_RIGHT  &kp LEFT_ALT   &mkp MB1
                                             &kp SPACE  &trans  &kp RIGHT_ALT    &trans     &trans          &trans
            >;
        };

        layer_7 {
            bindings = <
&trans     &kp F1  &kp F2  &kp F3  &kp F10    &kp PAGE_UP                       &kp PAGE_DOWN  &trans  &trans  &trans  &trans  &trans
&trans     &kp F4  &kp F5  &kp F6  &kp F11    &kp F13                           &trans         &trans  &trans  &trans  &trans  &kp ENTER
&kp LSHFT  &kp F7  &kp F8  &kp F9  &kp F12    &kp F14      &kp RCTRL    &none   &trans         &trans  &trans  &trans  &trans  &kp RSHFT
                                   &kp SPACE  &to 6        &kp LALT     &trans  &trans         &trans
            >;
        };

        layer_8 {
            bindings = <
&to 0      &none           &kp UP_ARROW    &kp F1           &kp F2     &kp F3                                   &none         &kp NUMBER_7  &kp NUMBER_7  &kp NUMBER_0    &kp UP_ARROW    &to 9
&kp RCTRL  &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT_ARROW  &none      &kp END                                  &kp NUMBER_1  &kp NUMBER_4  &kp NUMBER_7  &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT_ARROW
&none      &none           &none           &none            &none      &kp NUMBER_7  &kp NUMBER_9    &none      &kp NUMBER_1  &kp NUMBER_1  &none         &none           &none           &none
                                                            &kp LCTRL  &kp NUMBER_1  &kp NUMBER_3    &kp LCTRL  &kp LCTRL     &kp LCTRL
            >;
        };

        layer_9 {
            bindings = <
&to 0         &none  &kp ESC    &none    &none      &none                                    &none            &kp RSHFT  &kp UP_ARROW  &none    &none     &to 10
&kp UP_ARROW  &kp M  &kp COMMA  &kp DOT  &kp FSLH   &none                                    &none            &kp M      &kp COMMA     &kp DOT  &kp FSLH  &kp UP_ARROW
&kp RSHFT     &kp Z  &kp X      &kp C    &kp V      &kp RSHFT  &kp UP_ARROW    &kp UP_ARROW  &kp RIGHT_SHIFT  &kp Z      &kp X         &kp C    &kp V     &kp RSHFT
                                         &kp SPACE  &kp SPACE  &kp SPACE       &kp SPACE     &kp SPACE        &kp SPACE
            >;
        };

        layer_10 {
            bindings = <
&to 0  &kp N7  &kp N7  &kp N7        &kp F2  &kp N9                    &kp N7  &none   &kp N9  &kp N9  &none  &kp KP_NUMLOCK
&none  &none   &kp N4  &kp NUMBER_4  &kp N4  &kp N6                    &kp N4  &kp N6  &kp N6  &none   &none  &kp KP_ENTER
&none  &none   &kp N1  &kp N1        &kp N1  &kp N3  &none     &none   &kp N1  &kp N3  &kp N3  &none   &none  &none
                                     &kp N5  &kp N0  &kp N0    &kp N0  &kp N0  &kp N5
            >;
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";

        tri_layer {
            if-layers = <1 2>;
            then-layer = <3>;
        };
    };
};
