#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

&mt {
    flavor = "balanced";
    quick-tap-ms = <0>;
};

&lt {
    quick-tap-ms = <300>;
    flavor = "balanced";
};

/ {
    combos { compatible = "zmk,combos"; };

    macros {
        to_layer_0: to_layer_0 {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&to 0 &macro_param_1to1 &kp MACRO_PLACEHOLDER>;
            label = "TO_LAYER_0";
        };
    };

    behaviors {
        lt_to_layer_0: lt_to_layer_0 {
            compatible = "zmk,behavior-hold-tap";
            label = "LAYER_TAP_TO_0";
            bindings = <&mo>, <&to_layer_0>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp TAB        &kp Q  &kp W  &kp E  &kp R  &kp T                                     &kp Y      &kp U  &kp I      &kp O    &kp P         &kp SQT
&kp BACKSPACE  &kp A  &kp S  &kp D  &kp F  &kp G                                     &kp H      &kp J  &kp K      &kp L    &kp SEMI      &kp ENTER
&sk LSHFT      &kp Z  &kp X  &kp C  &kp V  &kp B      &caps_word      &kp RIGHT_WIN  &kp N      &kp M  &kp COMMA  &kp DOT  &kp LEFT_ALT  &sk RIGHT_SHIFT
                                    &mo 1  &kp LCTRL  &kp LEFT_ALT    &kp RCTRL      &kp SPACE  &mo 2
            >;
        };

        layer_1 {
            bindings = <
&kp ESCAPE      &kp GRAVE        &kp TILDE    &kp PLUS       &kp EQUAL     &sk LC(LEFT_SHIFT)                           &sk LS(LEFT_ALT)   &kp LESS_THAN   &kp GREATER_THAN   &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp RIGHT_GUI
&trans          &kp EXCLAMATION  &kp AT_SIGN  &kp HASH       &kp DOLLAR    &kp LEFT_BRACKET                             &kp RIGHT_BRACKET  &kp MINUS       &kp SQT            &kp LEFT_BRACE        &kp RIGHT_BRACE        &kp ENTER
&kp LEFT_SHIFT  &kp PERCENT      &kp CARET    &kp AMPERSAND  &kp ASTERISK  &kp QUESTION        &mo 3     &kp RIGHT_WIN  &kp COLON          &kp UNDERSCORE  &kp DOUBLE_QUOTES  &kp PIPE              &kp SLASH              &kp BACKSLASH
                                                             &trans        &trans              &trans    &kp RIGHT_ALT  &kp SPACE          &trans
            >;
        };

        layer_2 {
            bindings = <
&kp TAB    &kp NUMBER_1  &kp N2  &kp N3  &kp N1  &none                              &msc SCRL_LEFT  &msc SCRL_DOWN  &msc SCRL_UP  &msc SCRL_RIGHT  &to 4          &none
&trans     &kp N4        &kp N5  &kp N6  &kp N0  &mkp MB2                           &kp LEFT        &kp DOWN        &kp UP        &kp RIGHT        &kp RIGHT_GUI  &kp ENTER
&kp LSHFT  &kp N7        &kp N8  &kp N9  &kp M   &mkp MB1   &kp LCTRL    &kp RCTRL  &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_UP  &mmv MOVE_RIGHT  &kp LEFT_ALT   &mkp MB1
                                         &trans  &kp SPACE  &trans       &trans     &trans          &trans
            >;
        };

        layer_3 {
            bindings = <
&trans     &kp F1  &kp F2  &kp F3  &kp F10  &kp PAGE_UP                    &kp PAGE_DOWN  &none           &none      &kp LS(DELETE)  &kp RGUI       &kp PRINTSCREEN
&trans     &kp F4  &kp F5  &kp F6  &kp F11  &kp HOME                       &kp LS(HOME)   &kp LALT        &kp RCTRL  &kp RGUI        &kp RALT       &kp ENTER
&kp LSHFT  &kp F7  &kp F8  &kp F9  &kp F12  &kp END      &trans    &trans  &kp LS(END)    &sk LEFT_SHIFT  &sk RCTRL  &sk RIGHT_ALT   &sk RIGHT_GUI  &kp RSHFT
                                   &trans   &trans       &trans    &trans  &trans         &trans
            >;
        };

        layer_4 {
            bindings = <
&bt BT_CLR      &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4                    &trans  &trans  &trans  &trans  &trans  &trans
&bt BT_CLR_ALL  &trans        &trans        &trans        &trans        &trans                          &trans  &trans  &trans  &trans  &trans  &trans
&trans          &trans        &trans        &trans        &trans        &trans        &trans    &trans  &trans  &trans  &trans  &trans  &trans  &trans
                                                          &trans        &trans        &trans    &trans  &trans  &trans
            >;
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";

        tri_layer {
            if-layers = <1 2>;
            then-layer = <3>;
        };
    };
};
